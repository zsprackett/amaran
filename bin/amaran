#!/bin/zsh
# Thin entry point: build the Swift CLI if needed, then exec it. All command
# logic lives in the `amaran` SwiftPM executable (Sources/amaran, AmaranCLI).
set -euo pipefail

ROOT="${0:A:h:h}"
BIN="$ROOT/.build/release/amaran"

if [[ ! -x "$BIN" ]]; then
  echo "amaran: building CLI (first run)..." >&2
  swift build --package-path "$ROOT" -c release --product amaran >&2
fi

export AMARAN_ROOT="$ROOT"
exec "$BIN" "$@"
